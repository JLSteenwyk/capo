{
  "display_information": {
    "name": "capo",
    "description": "A Capo team for GitHub and project development"
  },
  "features": {
    "bot_user": {
      "display_name": "capo",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:read",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "socket_mode_enabled": true
  }
}
